<?xml version="1.0" encoding="UTF-8"?>

<!--
    Root Project Declaration
    Ye batata hai ki ye Maven Project hai.
    xmlns
    = Maven XML Namespace
    xsi
    = XML Validation
    schemaLocation
    = Maven ko batata hai ki XML kis schema ko follow karega.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!--
        Maven Model Version:
        Abhi tak saare Maven Projects me
        4.0.0 hi use hota hai.
    -->
    <modelVersion>4.0.0</modelVersion>

    <!-- ================================================= -->
    <!-- Parent Project                                    -->
    <!-- ================================================= -->
    <!--
        Ye auth-service ka Parent Project hai.
        Matlab auth-service
                ↓
        enterprise-ecommerce se inherit karega. Isse automatically milta hai:
        ✔ Java Version
        ✔ Dependency Versions
        ✔ Plugin Configurations
        ✔ Common Properties
        ✔ Common Build Configuration
        Har child module isi parent ko use karega.
    -->
    <parent>
        <!-- Parent Company -->
        <groupId>com.enterprise</groupId>
        <!-- Parent Project Name -->
        <artifactId>enterprise-ecommerce</artifactId>
        <!-- Parent Version -->
        <version>1.0.0</version>
    </parent>
    <!--
        Current Module Name: Ye microservice ka naam hai.
        Final Jar bhi isi naam se banega. Example: auth-service-1.0.0.jar
    -->
    <artifactId>auth-service</artifactId>
    <name>auth-service</name>
    <description>Authentication and Authorization Microservice</description>


    <!-- ================================================= -->
    <!-- Project Dependencies                              -->
    <!-- ================================================= -->
    <!-- Dependencies: Is module ko chalane ke liye. kaunsi libraries chahiye. Sab yaha define hoti hain. -->
    <dependencies>
        <!-- ================================================= -->
        <!-- Common Library                                    -->
        <!-- ================================================= -->
        <!-- Ye hamara khud ka module hai (common-lib).
             Isme rakhenge: ✔ DTO, ✔ ApiResponse, ✔ Constants, ✔ Exceptions, ✔ Utility Classes, ✔ Common Enums, ✔ Shared Objects
            Jitni bhi microservices hongi. sab isi dependency ko use karengi.
        -->
        <dependency>
            <groupId>com.enterprise</groupId>
            <artifactId>common-lib</artifactId>
            <!--
                Parent Project ka version use karega.
                Agar Parent Version(1.0.0) se (1.1.0) hua to ye automatically update ho jayega.
            -->
            <version>${project.version}</version>
        </dependency>


        <!-- ================================================= -->
        <!-- Spring Boot Web (REST APIs )                                  -->
        <!-- ================================================= -->
        <!-- Ye dependency Spring Boot ko Web Application banati hai.
            Iske bina:  @RestController, @RequestMapping, @GetMapping, @PostMapping, Embedded Tomcat, JSON, HTTP APIs
            kuch bhi available nahi hoga. Ye sabse important dependency hai.
        -->
        <!-- REST APIs -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>


        <!-- ================================================= -->
        <!-- Validation (Bean Validation)                                       -->
        <!-- ================================================= -->

        <!-- Bean Validation ke liye. Iske baad hum use kar sakte hain
            @Valid, @NotBlank, @NotNull, @Email, @Pattern, @Size etc.
        -->
        <!-- Bean Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- JPA + Hibernate -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- MySQL Driver -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- JWT Authentication-->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ================================================= -->
        <!-- Lombok                                            -->
        <!-- ================================================= -->

        <!-- Boilerplate Code hata deta hai. Generate karta hai
            ✔ Getter, ✔ Setter, ✔ Constructor, ✔ Builder, ✔ ToString, ✔ Equals HashCode,optional=true
            Matlab: Runtime me is dependency ki zarurat nahi padegi. Sirf compile time pe use hogi.
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Swagger / OpenAPI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- Health & Monitoring -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ================================================= -->
        <!-- Testing                                           -->
        <!-- ================================================= -->

        <!-- Testing Framework Iske andar milta hai
            ✔ JUnit 5, ✔ Mockito, ✔ Spring Test, ✔ MockMvc, ✔ AssertJ
            Ye sirf test likhne ke liye hai. Production me include nahi hota.
             Isliye: scope = test
        -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>


    <!-- ================================================= -->
    <!-- Build Section                                      -->
    <!-- ================================================= -->
    <!-- Build Section: Yaha Maven Build Plugins aate hain.
        Plugin = Maven ko extra capability dena.
    -->
    <build>
        <plugins>
            <!-- ================================================= -->
            <!-- Spring Boot Maven Plugin                          -->
            <!-- ================================================= -->
            <!-- Ye plugin sirf Spring Boot Application me use hota hai.
                Iske kaam: ✔ Executable Jar banana, ✔ Spring Boot Repackage, ✔ mvn spring-boot:run, ✔ Fat Jar banana, ✔ Embedded Server Support
                Dhyan rahe Ye plugin common-lib module me kabhi nahi lagana. Kyunki common-lib  executable application nahi hai.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>